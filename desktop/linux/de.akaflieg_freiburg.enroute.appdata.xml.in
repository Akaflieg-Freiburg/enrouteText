  <url type="help">https://akaflieg-freiburg.github.io/enrouteManual/index.html</url>
  <url type="vcs-browser">https://github.com/Akaflieg-Freiburg/enroute</url>
  <url type="translate">https://github.com/Akaflieg-Freiburg/enrouteText</url>
  <update_contact>stefan.kebekus@gmail.com</update_contact>
